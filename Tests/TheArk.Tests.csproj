<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RimWorldPath Condition="'$(RimWorldPath)' == ''">$(RIMWORLD_PATH)</RimWorldPath>
  </PropertyGroup>
  <Import Project="../Source/RimWorld.local.props" Condition="Exists('../Source/RimWorld.local.props')" />
  <PropertyGroup>
    <RimWorldPath Condition="'$(RimWorldPath)' == ''">C:/Program Files (x86)/Steam/steamapps/common/RimWorld</RimWorldPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Source/TheArk/TheArk.csproj" />
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldPath)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorldPath)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <AssemblyMetadata Include="RimWorldPath" Value="$(RimWorldPath)" />
    <AssemblyMetadata Include="RepositoryPath" Value="$(MSBuildProjectDirectory)/.." />
  </ItemGroup>
</Project>
